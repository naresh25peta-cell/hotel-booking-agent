FROM python:3.11-slim

WORKDIR /app

# System libraries required by psycopg[binary] and psycopg2-binary
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

COPY pyproject.toml .

# Parse pyproject.toml and install all declared dependencies
RUN python3 -c "import tomllib; deps=tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; open('/tmp/reqs.txt','w').write('\n'.join(deps))" && \
    pip install --no-cache-dir -r /tmp/reqs.txt

COPY . .

RUN mkdir -p logs

EXPOSE 8000

CMD ["sh", "-c", "python create_tables.py && python backend/db/seed.py && uvicorn backend.api.main:app --host 0.0.0.0 --port 8000"]
